<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header meals="meals"}}
            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">
                            <h1>Meals</h1>
                            <ul id="foods">
                                {{#each meals}}
                                <li>
                                    <a href="/meals"><img src="images//{{this.image}}" alt="Img"></a>
                                    <h2><a href="/meals">{{this.name}}</a></h2>
                                    {{{this.description}}}
                                </li>
                                {{/each}}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{> footer meals="meals"}}
    </div>
</body>
</html>